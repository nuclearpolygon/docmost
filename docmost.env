# shellcheck disable=SC2034
APP_URL=${APP_URL}
PORT=${PORT:-3000}
APP_SECRET=${DOCMOST_SECRET}
DATABASE_URL="postgresql://postgres:${DB_PASSWORD}@${DB_HOST:-db}:5432/docmost?schema=public"
REDIS_URL=${REDIS_URL:-redis://redis:6379}

# SMTP
MAIL_DRIVER=${MAIL_DRIVER:-smtp}
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT}
SMTP_USERNAME=${SMTP_USERNAME}
SMTP_PASSWORD=${SMTP_PASSWORD}
MAIL_FROM_ADDRESS=${SMTP_USERNAME}
MAIL_FROM_NAME=${MAIL_FROM_NAME:-Docmost}
SMTP_SECURE=${SMTP_SECURE:-false}
SMTP_IGNORETLS=${SMTP_IGNORETLS:-false}


FILE_UPLOAD_SIZE_LIMIT=${FILE_UPLOAD_SIZE_LIMIT:-200mb}
JWT_TOKEN_EXPIRES_IN=${JWT_TOKEN_EXPIRES_IN:-30d}

# options: local | s3
STORAGE_DRIVER=${STORAGE_DRIVER:-local}

